# VinhaVibe — Template de variáveis de ambiente
# Copia este ficheiro para `.env` e preenche com as tuas chaves reais.
# O ficheiro `.env` NÃO deve ser commitado (ver .gitignore).

# ==================================================================
# CLIENTE — embutido no bundle da app
# ==================================================================
#
# ATENÇÃO: tudo o que tem o prefixo EXPO_PUBLIC_ é inserido no bundle
# JavaScript em build time. Qualquer pessoa que descarregue o APK/IPA
# consegue extrair estes valores. Só podem estar aqui valores que possam
# ser públicos.
#
# A anon key do Supabase é segura aqui *desde que* o RLS esteja activo —
# é esse o modelo de segurança do Supabase. Ver supabase/migrations/.

EXPO_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...


# ==================================================================
# SERVIDOR — secrets das Edge Functions, NUNCA no bundle
# ==================================================================
#
# A especificação original colocava estas chaves em EXPO_PUBLIC_*, o que as
# tornava extraíveis por qualquer pessoa (e a conta faturável por qualquer
# pessoa). Passam a ser secrets das Edge Functions do Supabase.
#
# Definir com:
#   npx supabase secrets set GEMINI_API_KEY=AIza...
#
# Estas variáveis NÃO são lidas pela app — ficam aqui só como referência
# do que é preciso configurar no servidor.

# Google Gemini (gratuito em ai.google.dev) — usado por scan/fatura/sommelier
GEMINI_API_KEY=AIza...

# Wine-Searcher (preços em tempo real — wine-searcher.com/api)
WINE_SEARCHER_API_KEY=

# OpenWeatherMap (gratuito em openweathermap.org/api)
WEATHER_API_KEY=

# football-data.org (gratuito para Liga PT + UCL)
FOOTBALL_API_KEY=

# Stripe — a secret key só pode existir no servidor
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...


# ==================================================================
# STRIPE — chave publicável (esta pode ir no cliente)
# ==================================================================

EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
